---
import { ArrowRight, Phone, MapPin } from "lucide-react";
import * as LucideIcons from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import SplitSection from "@/components/sections/SplitSection.astro";
import BenefitGrid from "@/components/sections/BenefitGrid.astro";
import FAQSection from "@/components/sections/FAQSection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import QuoteSection from "@/components/sections/QuoteSection.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import MapEmbed from "@/components/ui/MapEmbed.astro";
import { serviceAreas } from "@/config/service-areas";
import { businessConfig } from "@/config/business";
import { imageManifest } from "@/config/images";
import { generatePageMetadata } from "@/lib/metadata";
import {
  generateAreaServiceSchema,
  generateBreadcrumbSchema,
} from "@/lib/structured-data";
import type { ServiceAreaConfig } from "@/types";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

export async function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: ServiceAreaConfig;
}

const { area } = Astro.props as Props;

const ctaProps = {
  primary: { label: "Get a Free Quote", href: "/contact" },
  secondary: {
    label: `Call ${businessConfig.phone}`,
    href: `tel:${businessConfig.phoneRaw}`,
  },
};

const meta = generatePageMetadata({
  title: area.metaTitle,
  description: area.metaDescription,
  path: `/service-areas/${area.slug}`,
});

const areaSchema = generateAreaServiceSchema(area);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", href: "/" },
  { name: "Service Areas", href: "/service-areas" },
  { name: `${area.city}, NH`, href: `/service-areas/${area.slug}` },
]);

const nearby = area.nearbyAreas
  .map((slug) => serviceAreas.find((a) => a.slug === slug))
  .filter(Boolean) as ServiceAreaConfig[];

const heroImg = imageManifest[area.heroImageKey];
const publicDir = fileURLToPath(new URL("../../../public", import.meta.url));
const heroPreload =
  heroImg && existsSync(publicDir + heroImg.src) ? heroImg.src : undefined;

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const iconFor = (name: string) => (LucideIcons as any)[name] || LucideIcons.Zap;
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  ogTitle={meta.ogTitle}
  preloadImage={heroPreload}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(areaSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  {/* Page Hero */}
  <PageHero
    heading={area.h1}
    subtitle={area.metaDescription}
    imageKey={area.heroImageKey}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Service Areas", href: "/service-areas" },
      { label: `${area.city}, NH` },
    ]}
    primaryCta={ctaProps.primary}
    secondaryCta={ctaProps.secondary}
  />

  {/* Local intro */}
  <SplitSection
    imageKey={area.featureImageKey}
    imagePosition="right"
    imageAspect="4/3"
  >
    <SectionHeading eyebrow={area.introEyebrow} heading={area.introHeading} />
    {
      area.intro.map((p) => (
        <p class="mb-4 text-base leading-relaxed text-muted md:text-lg">{p}</p>
      ))
    }
    <div class="mt-6 flex flex-wrap gap-4">
      <Button href="/contact">
        Get a Free Quote
        <ArrowRight slot="icon" className="h-5 w-5" />
      </Button>
      <Button href={`tel:${businessConfig.phoneRaw}`} variant="outline">
        {businessConfig.phone}
        <Phone slot="icon" className="h-5 w-5" />
      </Button>
    </div>
  </SplitSection>

  {/* Services for this town — linked cards */}
  <section class="section-padding bg-surface">
    <Container>
      <SectionHeading
        eyebrow={`${area.city} · ${area.county} County`}
        heading={area.servicesHeading}
        subtitle={area.servicesSubtitle}
        align="center"
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          area.servicesHighlight.map((item) => {
            const Icon = iconFor(item.icon);
            return (
              <a
                href={item.href}
                class="group flex flex-col rounded-2xl bg-white p-6 shadow-card transition-all hover:-translate-y-1 hover:shadow-card-hover"
              >
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary-100">
                  <Icon className="h-5 w-5 text-primary-700" />
                </div>
                <h3 class="mt-4 text-lg font-bold text-foreground group-hover:text-primary-700">
                  {item.title}
                </h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">
                  {item.description}
                </p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold uppercase tracking-wider text-primary-700">
                  Learn More
                  <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </span>
              </a>
            );
          })
        }
      </div>
    </Container>
  </section>

  {/* Why us, localized */}
  <BenefitGrid
    benefits={area.whyUs}
    eyebrow="Local Advantage"
    heading={area.whyHeading}
    primaryCta={ctaProps.primary}
    secondaryCta={ctaProps.secondary}
  />

  {/* Town map */}
  <section class="section-padding bg-surface">
    <Container>
      <SectionHeading
        eyebrow="On the Map"
        heading={area.mapHeading}
        align="center"
      />
      <div class="overflow-hidden rounded-2xl shadow-card-hover">
        <MapEmbed
          src={area.mapEmbedSrc}
          title={`Google map of ${area.city}, NH`}
          class="h-[400px] w-full md:h-[480px]"
        />
      </div>
    </Container>
  </section>

  {/* FAQ */}
  <FAQSection
    eyebrow="Local Questions"
    heading={area.faqHeading}
    items={area.faqs}
  />

  {/* Nearby areas — internal link mesh */}
  {
    nearby.length > 0 && (
      <section class="section-padding-sm bg-white">
        <Container>
          <div class="flex flex-col items-center gap-5 text-center">
            <h2 class="text-xl font-bold text-foreground md:text-2xl">
              Also Serving Neighbors of {area.city}
            </h2>
            <div class="flex flex-wrap items-center justify-center gap-3">
              {nearby.map((n) => (
                <a
                  href={`/service-areas/${n.slug}`}
                  class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-foreground-light transition-colors hover:border-primary-300 hover:bg-primary-50 hover:text-primary-700"
                >
                  <MapPin className="h-3.5 w-3.5" />
                  {n.city}, NH
                </a>
              ))}
            </div>
          </div>
        </Container>
      </section>
    )
  }

  {/* CTA */}
  <CTASection
    heading={area.ctaHeading}
    text={area.ctaText}
    primaryCta={ctaProps.primary}
    secondaryCta={ctaProps.secondary}
  />

  {/* Quote Form */}
  <QuoteSection />
</Layout>
