---
import Layout from "@/layouts/Layout.astro";
import LegalArticle from "@/components/sections/LegalArticle.astro";
import { legalEffectiveDate } from "@/config/legal";

const title = "Privacy Policy | The Speedy Sparky LLC";
const description = "How The Speedy Sparky LLC collects, uses, and protects customer information, including mobile phone numbers and text messaging consent.";
---

<Layout title={title} description={description} solidHeader>
  <LegalArticle title="Privacy Policy" effectiveDate={legalEffectiveDate}>
    <p>
      The Speedy Sparky LLC ("The Speedy Sparky," "we," "us," or "our") is a
      licensed electrical contractor based in Manchester, New Hampshire. This
      Privacy Policy explains what information we collect, how we use it, and the
      choices you have. It applies to our website,
      <a href="https://thespeedyspark.com/">thespeedyspark.com</a>, and to the
      calls, emails, and text messages we exchange with customers.
    </p>

    <h2>Information we collect</h2>
    <ul>
      <li>Contact information you give us, such as your name, phone number, mobile phone number, email address, and the address of the property where work is requested.</li>
      <li>Details about your project, such as the description of the work, photos you send us, and scheduling preferences.</li>
      <li>Records of our communications with you, including emails and text messages.</li>
      <li>Billing information needed to prepare quotes and invoices. Card and bank payments are processed by our payment provider; we do not store full card or bank account numbers.</li>
      <li>Basic website usage information, such as pages visited and the type of device or browser used.</li>
    </ul>

    <h2>How we use your information</h2>
    <ul>
      <li>To respond to your inquiry and prepare quotes.</li>
      <li>To schedule, perform, and follow up on electrical work.</li>
      <li>To send appointment confirmations, visit reminders, quotes, invoices, receipts, and other messages about your service.</li>
      <li>To keep business, tax, and warranty records.</li>
      <li>To maintain and improve our website and services.</li>
    </ul>

    <h2>Text messaging (SMS)</h2>
    <p>
      If you give us your mobile phone number and agree to receive text messages,
      we will use it to send messages about your service, such as quote and invoice
      notifications, appointment confirmations and reminders, and replies to your questions.
    </p>
    <p>
      No mobile information will be shared with third parties or affiliates for
      marketing or promotional purposes. Text messaging opt-in data and consent
      are not shared with, sold to, or rented to any third parties. This information
      is used only to send you the messages you agreed to receive.
    </p>
    <p>
      You can stop text messages at any time by replying STOP to any message.
      Reply HELP for help. Message frequency varies. Message and data rates may apply.
    </p>

    <h2>How we share information</h2>
    <p>We do not sell your personal information. We share it only:</p>
    <ul>
      <li>With service providers that help us run our business, such as our scheduling, invoicing, messaging, and payment software, and only so they can provide those services to us.</li>
      <li>With inspectors, utilities, or permitting offices when required to complete your job.</li>
      <li>When required by law, or to protect our rights, our customers, or the public.</li>
    </ul>
    <p>
      These categories of sharing do not include text messaging opt-in data and
      consent, which are not shared with any third parties.
    </p>

    <h2>How long we keep information</h2>
    <p>
      We keep customer and job records for as long as needed to provide service,
      honor warranties, and meet legal, tax, and accounting requirements.
    </p>

    <h2>Security</h2>
    <p>
      We use reasonable measures to protect your information. No method of storage
      or transmission is completely secure, so we cannot guarantee absolute security.
    </p>

    <h2>Your choices</h2>
    <ul>
      <li>You can ask us to update or correct your contact information.</li>
      <li>You can ask us to stop contacting you by text, email, or phone.</li>
      <li>You can ask what information we hold about you, or ask us to delete it, subject to records we are required to keep.</li>
    </ul>

    <h2>Children</h2>
    <p>Our services are intended for adults. We do not knowingly collect information from children under 13.</p>

    <h2>Changes to this policy</h2>
    <p>We may update this policy from time to time. The effective date at the top shows when it was last changed.</p>

    <h2>Contact us</h2>
    <p>
      The Speedy Sparky LLC<br />
      Manchester, New Hampshire<br />
      Phone: <a href="tel:+16036618432">(603) 661-8432</a><br />
      Email: <a href="mailto:thespeedysparkyllc@gmail.com">thespeedysparkyllc@gmail.com</a>
    </p>
  </LegalArticle>
</Layout>
