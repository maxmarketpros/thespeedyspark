---
import {
  Phone,
  Zap,
  Flame,
  AlertTriangle,
  Gauge,
  PlugZap,
  Lightbulb,
  ShieldCheck,
  ClipboardCheck,
  CalendarCheck,
  ArrowRight,
  SearchCheck,
  CheckCircle2,
} from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import TrustBar from "@/components/landing/TrustBar.astro";
import StickyCallBar from "@/components/landing/StickyCallBar.astro";
import LandingQuoteSection from "@/components/landing/LandingQuoteSection.astro";
import RevealInit from "@/components/landing/RevealInit.astro";
import FAQSection from "@/components/sections/FAQSection.astro";
import SplitSection from "@/components/sections/SplitSection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ChecklistItem from "@/components/ui/ChecklistItem.astro";
import ImageSlot from "@/components/ui/ImageSlot.astro";
import ReviewCard from "@/components/ui/ReviewCard.astro";
import GoogleReviewsPill from "@/components/ui/GoogleReviewsPill.astro";
import { businessConfig } from "@/config/business";
import { panelLandingReviews } from "@/config/reviews";
import { imageManifest } from "@/config/images";
import { generatePageMetadata } from "@/lib/metadata";
import {
  generateLandingServiceSchema,
  generateBreadcrumbSchema,
} from "@/lib/structured-data";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

const meta = generatePageMetadata({
  title: "Electrical Panel Upgrades Manchester NH | The Speedy Sparky",
  description:
    "200-amp panel upgrades & fuse box replacements for NH homes — most done in one day. Licensed electrician, permit & inspection included. Free firm quote.",
  path: "/electrical-panel-upgrades",
});

const serviceSchema = generateLandingServiceSchema({
  name: "Electrical Panel Upgrades",
  description: meta.description,
  path: "/electrical-panel-upgrades",
});
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", href: "/" },
  { name: "Electrical Panel Upgrades", href: "/electrical-panel-upgrades" },
]);

const heroChips = [
  "One-day panel swaps",
  "Firm written quotes",
  "Fuse boxes & recalled panels",
  "Eversource scheduling handled",
];

const warningSigns = [
  {
    icon: Lightbulb,
    title: "Lights Flicker or Dim",
    text: "Especially when the dryer or space heater kicks on — a classic overloaded-panel symptom.",
    severity: "look",
  },
  {
    icon: AlertTriangle,
    title: "Breakers Trip Constantly",
    text: "Resetting the same breaker every week is your panel waving a flag.",
    severity: "today",
  },
  {
    icon: Flame,
    title: "Warm Panel or Burning Smell",
    text: "Heat or odor at the panel means call now — this is how electrical fires start.",
    severity: "now",
  },
  {
    icon: Gauge,
    title: "Still on 60 or 100 Amps",
    text: "Common in homes built before 1970 — and undersized for how we live now.",
    severity: "look",
  },
  {
    icon: ShieldCheck,
    title: "Fuse Box or Recalled Panel",
    text: "Fuses, Federal Pacific, and Zinsco panels can raise premiums or void coverage.",
    severity: "today",
  },
  {
    icon: PlugZap,
    title: "Planning an EV or Heat Pump",
    text: "Big new loads need headroom — upgrade the panel first and everything else gets simple.",
    severity: "look",
  },
];

const steps = [
  {
    icon: SearchCheck,
    title: "Free Assessment",
    text: "We inspect your service, run a load calculation, and hand you one firm written price.",
  },
  {
    icon: CalendarCheck,
    title: "One-Day Swap",
    text: "Eversource disconnect scheduled, panel swapped, power back on — usually the same day.",
  },
  {
    icon: ClipboardCheck,
    title: "Inspected & Labeled",
    text: "Town inspection passed, every circuit labeled, paperwork ready for insurance and resale.",
  },
];

const whyChecklist = [
  "Ends the flickering lights and nuisance trips",
  "Retires fuse boxes and recalled Federal Pacific panels",
  "Sized by a real load calculation — not a guess",
  "Headroom for EV chargers, heat pumps, and hot tubs",
];

const included = [
  "New 200-amp panel with copper bus and quality breakers",
  "Load calculation sized to your home's real demand",
  "Eversource disconnect scheduled for you",
  "Every circuit traced, tested, and labeled",
  "Town permit and passing final inspection",
  "Insurance-ready documentation packet",
];

const gallery = [
  {
    imageKey: "home-panel-troubleshooting",
    caption: "Every circuit proven, not assumed",
  },
  {
    imageKey: "industrial-panel-multimeter",
    caption: "Voltage verified at every leg",
  },
];

const faqs = [
  {
    id: "faq-panel-lp-1",
    question: "How much does a panel upgrade cost in New Hampshire?",
    answer:
      "It depends on your existing service, meter location, and whether the entrance cable needs replacing. After a quick free assessment you get one firm written number — not an estimate that grows.",
  },
  {
    id: "faq-panel-lp-2",
    question: "How long is the power off?",
    answer:
      "Plan on most of one workday. We schedule the disconnect and reconnect with Eversource in advance, and we don't leave until everything is back on and tested.",
  },
  {
    id: "faq-panel-lp-3",
    question: "Do I need 200 amps, or is 100 enough?",
    answer:
      "A healthy 100-amp service is fine for many smaller homes. If an EV charger, heat pump, or addition is anywhere in your future, 200 amps is the standard — the load calculation tells us for sure.",
  },
  {
    id: "faq-panel-lp-4",
    question: "Will this be permitted and inspected?",
    answer:
      "Always — service changes require a permit and inspection in every town we serve, and we handle both. Your paperwork is delivered when we're done.",
  },
];

const severityTag = {
  now: { label: "Call now", class: "bg-accent-600 text-white", pulse: true },
  today: {
    label: "Call today",
    class: "bg-accent-50 text-accent-700 ring-1 ring-accent-200",
    pulse: false,
  },
  look: {
    label: "Worth a look",
    class: "bg-surface-dark text-foreground-light",
    pulse: false,
  },
} as const;

const heroImg = imageManifest["hero-panel"];
const publicDir = fileURLToPath(new URL("../../public", import.meta.url));
const heroPreload =
  heroImg && existsSync(publicDir + heroImg.src) ? heroImg.src : undefined;
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  ogTitle={meta.ogTitle}
  preloadImage={heroPreload}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(serviceSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  {/* Hero — homepage-style full-bleed dark image, centered */}
  <section class="relative flex min-h-screen items-center overflow-hidden">
    <ImageSlot
      imageKey="hero-panel"
      fill
      priority
      class="lp-bg-settle absolute inset-0 z-0"
      overlayClassName="bg-gradient-to-b from-black/70 via-black/55 to-black/75"
      sizes="100vw"
    />

    <Container class="relative z-10 py-32 text-center">
      <span
        class="lp-fade-up mb-4 inline-flex items-center gap-2.5 rounded-full bg-white/10 px-5 py-2 text-xs font-semibold uppercase tracking-widest text-white ring-1 ring-white/20 backdrop-blur-sm"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full rounded-full bg-secondary-400 motion-safe:animate-ping"
          >
          </span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-secondary-400"></span>
        </span>
        200-Amp Panel Upgrade Experts · Manchester &amp; Southern NH
      </span>

      <h1
        class="lp-fade-up mx-auto max-w-4xl text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl"
        style="--enter-delay: 80ms"
      >
        Electrical Panel Upgrades
        <span
          class="block bg-gradient-to-r from-secondary-300 to-secondary-400 bg-clip-text pb-1 text-transparent"
        >
          in Manchester, NH
        </span>
      </h1>

      <p
        class="lp-fade-up mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl"
        style="--enter-delay: 160ms"
      >
        Trade tripped breakers and flickering lights for a modern 200-amp
        panel — installed in one day by a licensed NH electrician, permit and
        inspection included.
      </p>

      <ul
        class="lp-fade-up mt-7 flex flex-wrap items-center justify-center gap-2.5"
        style="--enter-delay: 240ms"
      >
        {
          heroChips.map((chip) => (
            <li class="flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-2 text-sm font-medium text-white/90 ring-1 ring-white/15 backdrop-blur-sm">
              <CheckCircle2 className="h-4 w-4 shrink-0 text-secondary-400" />
              {chip}
            </li>
          ))
        }
      </ul>

      <div
        class="lp-fade-up mt-7 flex justify-center"
        style="--enter-delay: 320ms"
      >
        <GoogleReviewsPill />
      </div>

      <div
        class="lp-fade-up mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row"
        style="--enter-delay: 400ms"
      >
        <Button href="#quote" size="lg">
          Get My Free Quote
          <ArrowRight slot="icon" className="h-5 w-5" />
        </Button>
        <Button
          href={`tel:${businessConfig.phoneRaw}`}
          variant="outline"
          size="lg"
          class="border-white text-white hover:bg-white hover:text-foreground"
        >
          Call {businessConfig.phone}
          <Phone slot="icon" className="h-5 w-5" />
        </Button>
      </div>

      {/* Stats row — homepage shell, values count up on load */}
      <div
        class="lp-fade-up mx-auto mt-14 grid w-full max-w-lg grid-cols-3 divide-x divide-white/20 md:mt-16"
        style="--enter-delay: 480ms"
      >
        <div class="min-w-0 px-2 text-center sm:px-4">
          <p class="text-2xl font-bold text-white sm:text-3xl md:text-4xl">
            <span data-count-to="200" data-count-suffix="A">200A</span>
          </p>
          <p
            class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/70 sm:text-xs sm:tracking-widest"
          >
            Today's Standard Service
          </p>
        </div>
        <div class="min-w-0 px-2 text-center sm:px-4">
          <p
            class="whitespace-nowrap text-2xl font-bold text-white sm:text-3xl md:text-4xl"
          >
            1 Day
          </p>
          <p
            class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/70 sm:text-xs sm:tracking-widest"
          >
            Typical Panel Swap
          </p>
        </div>
        <div class="min-w-0 px-2 text-center sm:px-4">
          <p class="text-2xl font-bold text-white sm:text-3xl md:text-4xl">
            <span data-count-to="10" data-count-suffix="+">10+</span>
          </p>
          <p
            class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/70 sm:text-xs sm:tracking-widest"
          >
            Years in the Trade
          </p>
        </div>
      </div>
    </Container>
  </section>

  <TrustBar />

  {/* Warning signs — diagnostic cards */}
  <section class="section-padding bg-white">
    <Container>
      <div data-reveal>
        <SectionHeading
          eyebrow="Warning Signs"
          heading="Is Your Panel Telling You Something?"
          subtitle="Six signs we see every week in southern New Hampshire homes — any one of them is worth a phone call."
          align="center"
        />
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          warningSigns.map((item, i) => {
            const tag = severityTag[item.severity as keyof typeof severityTag];
            return (
              <div
                class="relative flex gap-4 rounded-2xl p-6 pr-5 ring-1 ring-border shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover"
                data-reveal
                style={`--reveal-delay: ${(i % 3) * 100}ms`}
              >
                <span
                  class={`absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider ${tag.class}`}
                >
                  {tag.pulse && (
                    <span class="relative flex h-1.5 w-1.5">
                      <span class="lp-pulse-ring absolute inline-flex h-full w-full rounded-full bg-white" />
                      <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-white" />
                    </span>
                  )}
                  {tag.label}
                </span>
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent-50">
                  <item.icon className="h-6 w-6 text-accent-600" />
                </span>
                <div class="pt-1">
                  <h3 class="pr-16 font-bold text-foreground">{item.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">
                    {item.text}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
      <div
        class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
        data-reveal
      >
        <Button href="#quote">
          Check My Panel — Free Quote
          <ArrowRight slot="icon" className="h-5 w-5" />
        </Button>
        <Button href={`tel:${businessConfig.phoneRaw}`} variant="outline">
          Call {businessConfig.phone}
          <Phone slot="icon" className="h-5 w-5" />
        </Button>
      </div>
    </Container>
  </section>

  {/* Why upgrade — homepage-style split section */}
  <SplitSection
    imageKey="panel-breaker-wiring"
    imagePosition="right"
    bgColor="surface"
    imageAspect="4/3"
    badge={{ value: "1", eyebrow: "Swapped in", label: "Just One Day" }}
  >
    <div data-reveal>
      <SectionHeading
        eyebrow="Why Upgrade"
        heading="Power for Today. Headroom for Tomorrow."
      />
      <p class="mb-6 text-base leading-relaxed text-muted md:text-lg">
        Most Manchester homes still run on panels sized for 1970s appliances.
        A modern 200-amp panel ends the nuisance trips today — and leaves room
        for whatever you plug in next.
      </p>
      <div class="mb-8 space-y-4">
        {whyChecklist.map((item) => <ChecklistItem text={item} />)}
      </div>
      <div class="flex flex-wrap gap-4">
        <Button href="#quote">
          Get My Free Quote
          <ArrowRight slot="icon" className="h-5 w-5" />
        </Button>
        <Button href={`tel:${businessConfig.phoneRaw}`} variant="outline">
          Call {businessConfig.phone}
          <Phone slot="icon" className="h-5 w-5" />
        </Button>
      </div>
    </div>
  </SplitSection>

  {/* 3-step process */}
  <section class="section-padding bg-white">
    <Container>
      <div data-reveal>
        <SectionHeading
          eyebrow="How It Works"
          heading="Old Panel Out. New Panel In. Same Day."
          align="center"
        />
      </div>
      <div class="relative grid gap-10 md:grid-cols-3 md:gap-8">
        <div
          class="absolute left-[18%] right-[18%] top-10 hidden border-t-2 border-dashed border-primary-200 md:block"
          aria-hidden="true"
        >
        </div>
        {
          steps.map((step, i) => (
            <div
              class="relative rounded-2xl bg-white p-7 ring-1 ring-border shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover"
              data-reveal
              style={`--reveal-delay: ${i * 120}ms`}
            >
              <div class="absolute -top-4 left-7 flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-primary-600 to-secondary-500 text-sm font-bold text-white shadow-badge">
                {i + 1}
              </div>
              <step.icon className="h-8 w-8 text-primary-600" />
              <h3 class="mt-4 text-lg font-bold text-foreground">
                {step.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* What's included — blueprint-grid dark band */}
  <section class="relative overflow-hidden section-padding bg-primary-900">
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:56px_56px]"
      aria-hidden="true"
    >
    </div>
    <Container class="relative">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div data-reveal>
          <h2 class="text-3xl font-bold text-white md:text-4xl">
            One Number. The Whole Job.
          </h2>
          <p class="mt-4 text-white/80">
            No estimate that grows, no surprises on install day — your written
            quote covers everything:
          </p>
        </div>
        <ul
          class="grid gap-3 sm:grid-cols-2"
          data-reveal
          style="--reveal-delay: 150ms"
        >
          {
            included.map((item) => (
              <li class="flex items-start gap-2.5 rounded-lg bg-white/5 px-3 py-2.5 text-sm text-white/90 ring-1 ring-white/10">
                <Zap className="mt-0.5 h-4 w-4 shrink-0 text-secondary-400" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  {/* Work gallery */}
  <section class="section-padding bg-white">
    <Container>
      <div data-reveal>
        <SectionHeading
          eyebrow="Recent Work"
          heading="Tested to Inspection Standards. Then Ours."
          align="center"
        />
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {
          gallery.map((item, i) => (
            <div
              class="relative"
              data-reveal
              style={`--reveal-delay: ${i * 120}ms`}
            >
              <ImageSlot
                imageKey={item.imageKey}
                aspectRatio="16/10"
                sizes="(min-width: 768px) 50vw, 100vw"
                class="rounded-3xl shadow-card"
              />
              <span class="absolute bottom-3 left-3 max-w-[calc(100%-1.5rem)] rounded-lg bg-foreground/70 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur">
                {item.caption}
              </span>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* Reviews */}
  <section class="section-padding bg-surface">
    <Container>
      <div class="flex flex-col items-center text-center" data-reveal>
        <SectionHeading
          eyebrow="Google Reviews"
          heading="Panel Work the Neighbors Vouch For"
          align="center"
          class="mb-5"
        />
        <GoogleReviewsPill variant="bordered" />
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          panelLandingReviews.map((review, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 120}ms`}>
              <ReviewCard review={review} class="h-full" />
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* FAQ */}
  <FAQSection
    eyebrow="Panel Questions"
    heading="Asked Before Every Upgrade"
    items={faqs}
    bgColor="white"
  />

  {/* Final CTA — homepage band */}
  <CTASection
    heading="A 1960s Panel Wasn't Built for a 2026 Home"
    text="Free assessment, one firm number — most panels swapped within the week."
    primaryCta={{ label: "Get My Free Quote", href: "#quote" }}
    secondaryCta={{
      label: `Call ${businessConfig.phone}`,
      href: `tel:${businessConfig.phoneRaw}`,
    }}
  />

  {/* Quote form — the page's single #quote anchor */}
  <LandingQuoteSection
    tone="panel"
    eyebrow="Free Panel Assessment"
    heading="One Written Number, Not an Estimate"
    formHeading="Get Your Panel Upgrade Quote"
    formSubheading="Free assessment, firm number, zero pressure."
    bullets={[
      "Free assessment — clear photos of your panel work fine",
      "The price you sign is the price you pay",
      "Eversource scheduling handled start to finish",
    ]}
    urgencyNote="Assessment slots open this week across Manchester and southern NH."
  />

  <RevealInit />
  <StickyCallBar showQuote />
</Layout>
