---
import {
  Phone,
  Zap,
  BatteryCharging,
  CalendarCheck,
  ArrowRight,
  CheckCircle2,
} from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import TrustBar from "@/components/landing/TrustBar.astro";
import StickyCallBar from "@/components/landing/StickyCallBar.astro";
import LandingQuoteSection from "@/components/landing/LandingQuoteSection.astro";
import RevealInit from "@/components/landing/RevealInit.astro";
import FAQSection from "@/components/sections/FAQSection.astro";
import SplitSection from "@/components/sections/SplitSection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ChecklistItem from "@/components/ui/ChecklistItem.astro";
import ImageSlot from "@/components/ui/ImageSlot.astro";
import ReviewCard from "@/components/ui/ReviewCard.astro";
import GoogleReviewsPill from "@/components/ui/GoogleReviewsPill.astro";
import { businessConfig } from "@/config/business";
import { evLandingReviews } from "@/config/reviews";
import { imageManifest } from "@/config/images";
import { generatePageMetadata } from "@/lib/metadata";
import {
  generateLandingServiceSchema,
  generateBreadcrumbSchema,
} from "@/lib/structured-data";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

const meta = generatePageMetadata({
  title: "EV Charger Installation Manchester NH | The Speedy Sparky",
  description:
    "Level 2 EV charger installed at your NH home — usually in one visit. Licensed electrician, permits handled, tax-credit guidance. Free quote in minutes.",
  path: "/ev-charger-installation",
});

const serviceSchema = generateLandingServiceSchema({
  name: "EV Charger Installation",
  description: meta.description,
  path: "/ev-charger-installation",
});
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", href: "/" },
  { name: "EV Charger Installation", href: "/ev-charger-installation" },
]);

const heroChips = [
  "One-morning installs",
  "Every charger brand",
  "Panel load-check included",
  "Outdoor-rated options",
];

const steps = [
  {
    icon: Phone,
    title: "Five-Minute Quote",
    text: "Tell us your car and send a photo of your panel — most quotes come back same day.",
  },
  {
    icon: CalendarCheck,
    title: "One-Morning Install",
    text: "Dedicated 240V circuit, charger mounted and wired, permit pulled.",
  },
  {
    icon: BatteryCharging,
    title: "Plug In Tonight",
    text: "We commission the charger, connect the app, and set your off-peak schedule.",
  },
];

const whyChecklist = [
  "Up to 9× faster than a wall outlet",
  "30% federal tax credit — paperwork included",
  "Panel load-check before we quote",
  "Battery preconditioning for NH winter mornings",
];

const included = [
  "Dedicated 240V circuit from your panel",
  "Any charger brand — yours or ours",
  "Town permit and final inspection",
  "Indoor or weatherproof outdoor mounting",
  "App setup with off-peak schedule",
  "Federal 30C tax-credit documentation",
];

const gallery = [
  {
    imageKey: "ev-charger-unit-closeup",
    caption: "Load-tested before we hand it over",
  },
  {
    imageKey: "ev-charger-garage-mount",
    caption: "Commissioned, app-connected, ready",
  },
];

const faqs = [
  {
    id: "faq-ev-lp-1",
    question: "How much does EV charger installation cost in NH?",
    answer:
      "Most installs with the panel within about 25 feet land in a range we can quote over the phone. Either way, you get a firm number in writing before we start.",
  },
  {
    id: "faq-ev-lp-2",
    question: "Which chargers do you install?",
    answer:
      "All of them — Tesla Wall Connector, ChargePoint, Emporia, Grizzl-E, JuiceBox. Already own one? We'll install it.",
  },
  {
    id: "faq-ev-lp-3",
    question: "What if my panel can't handle a charger?",
    answer:
      "We run a load calculation first, and often a smart load-management setting solves it. If the panel truly needs an upgrade, we quote both together.",
  },
  {
    id: "faq-ev-lp-4",
    question: "How soon can you install it?",
    answer:
      "Usually within the week — quotes typically come back same day, and the install takes one morning.",
  },
];

const heroImg = imageManifest["hero-ev"];
const publicDir = fileURLToPath(new URL("../../public", import.meta.url));
const heroPreload =
  heroImg && existsSync(publicDir + heroImg.src) ? heroImg.src : undefined;
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  ogTitle={meta.ogTitle}
  preloadImage={heroPreload}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(serviceSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  {/* Hero — homepage-style full-bleed dark image, centered */}
  <section class="relative flex min-h-screen items-center overflow-hidden">
    <ImageSlot
      imageKey="hero-ev"
      fill
      priority
      class="lp-bg-settle absolute inset-0 z-0"
      overlayClassName="bg-gradient-to-b from-black/70 via-black/55 to-black/75"
      sizes="100vw"
    />

    <Container class="relative z-10 py-32 text-center">
      <span
        class="lp-fade-up mb-4 inline-flex items-center gap-2.5 rounded-full bg-white/10 px-5 py-2 text-xs font-semibold uppercase tracking-widest text-white ring-1 ring-white/20 backdrop-blur-sm"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full rounded-full bg-secondary-400 motion-safe:animate-ping"
          >
          </span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-secondary-400"></span>
        </span>
        Level 2 EV Charger Experts · Manchester &amp; Southern NH
      </span>

      <h1
        class="lp-fade-up mx-auto max-w-4xl text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl"
        style="--enter-delay: 80ms"
      >
        EV Charger Installation
        <span
          class="block bg-gradient-to-r from-secondary-300 to-secondary-400 bg-clip-text pb-1 text-transparent"
        >
          in Manchester, NH
        </span>
      </h1>

      <p
        class="lp-fade-up mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl"
        style="--enter-delay: 160ms"
      >
        Wake up fully charged every morning — a licensed NH electrician
        installs your Level 2 charger in one visit, permit and tax-credit
        paperwork included.
      </p>

      <ul
        class="lp-fade-up mt-7 flex flex-wrap items-center justify-center gap-2.5"
        style="--enter-delay: 240ms"
      >
        {
          heroChips.map((chip) => (
            <li class="flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-2 text-sm font-medium text-white/90 ring-1 ring-white/15 backdrop-blur-sm">
              <CheckCircle2 className="h-4 w-4 shrink-0 text-secondary-400" />
              {chip}
            </li>
          ))
        }
      </ul>

      <div
        class="lp-fade-up mt-7 flex justify-center"
        style="--enter-delay: 320ms"
      >
        <GoogleReviewsPill />
      </div>

      <div
        class="lp-fade-up mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row"
        style="--enter-delay: 400ms"
      >
        <Button href="#quote" size="lg">
          Get My Free Quote
          <ArrowRight slot="icon" className="h-5 w-5" />
        </Button>
        <Button
          href={`tel:${businessConfig.phoneRaw}`}
          variant="outline"
          size="lg"
          class="border-white text-white hover:bg-white hover:text-foreground"
        >
          Call {businessConfig.phone}
          <Phone slot="icon" className="h-5 w-5" />
        </Button>
      </div>

      {/* Stats row — homepage shell, values count up on load */}
      <div
        class="lp-fade-up mx-auto mt-14 grid w-full max-w-lg grid-cols-3 divide-x divide-white/20 md:mt-16"
        style="--enter-delay: 480ms"
      >
        <div class="min-w-0 px-2 text-center sm:px-4">
          <p class="text-2xl font-bold text-white sm:text-3xl md:text-4xl">
            <span data-count-to="9" data-count-suffix="×">9×</span>
          </p>
          <p
            class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/70 sm:text-xs sm:tracking-widest"
          >
            Faster Than an Outlet
          </p>
        </div>
        <div class="min-w-0 px-2 text-center sm:px-4">
          <p
            class="whitespace-nowrap text-2xl font-bold text-white sm:text-3xl md:text-4xl"
          >
            25–40
          </p>
          <p
            class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/70 sm:text-xs sm:tracking-widest"
          >
            Miles of Range / Hour
          </p>
        </div>
        <div class="min-w-0 px-2 text-center sm:px-4">
          <p class="text-2xl font-bold text-white sm:text-3xl md:text-4xl">
            <span data-count-to="1000" data-count-prefix="$">$1,000</span>
          </p>
          <p
            class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/70 sm:text-xs sm:tracking-widest"
          >
            Max Federal Tax Credit
          </p>
        </div>
      </div>
    </Container>
  </section>

  <TrustBar />

  {/* 3-step process */}
  <section class="section-padding bg-white">
    <Container>
      <div data-reveal>
        <SectionHeading
          eyebrow="How It Works"
          heading="Installed in a Morning. Charging by Tonight."
          align="center"
        />
      </div>
      <div class="relative grid gap-10 md:grid-cols-3 md:gap-8">
        <div
          class="absolute left-[18%] right-[18%] top-10 hidden border-t-2 border-dashed border-primary-200 md:block"
          aria-hidden="true"
        >
        </div>
        {
          steps.map((step, i) => (
            <div
              class="relative rounded-2xl bg-white p-7 ring-1 ring-border shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover"
              data-reveal
              style={`--reveal-delay: ${i * 120}ms`}
            >
              <div class="absolute -top-4 left-7 flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-primary-600 to-secondary-500 text-sm font-bold text-white shadow-badge">
                {i + 1}
              </div>
              <step.icon className="h-8 w-8 text-primary-600" />
              <h3 class="mt-4 text-lg font-bold text-foreground">
                {step.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* Why Level 2 — homepage-style split section */}
  <SplitSection
    imageKey="ev-charger-wall-install"
    imagePosition="right"
    bgColor="surface"
    imageAspect="4/3"
    badge={{ value: "1", eyebrow: "Installed in", label: "Just One Morning" }}
  >
    <div data-reveal>
      <SectionHeading
        eyebrow="Why Level 2"
        heading="Charge While You Sleep. Save While You Drive."
      />
      <p class="mb-6 text-base leading-relaxed text-muted md:text-lg">
        A wall outlet adds 3–5 miles of range an hour; a Level 2 charger adds
        25–40. We size it to your panel, and the whole install qualifies for
        the 30% federal tax credit.
      </p>
      <div class="mb-8 space-y-4">
        {whyChecklist.map((item) => <ChecklistItem text={item} />)}
      </div>
      <div class="flex flex-wrap gap-4">
        <Button href="#quote">
          Get My Free Quote
          <ArrowRight slot="icon" className="h-5 w-5" />
        </Button>
        <Button href={`tel:${businessConfig.phoneRaw}`} variant="outline">
          Call {businessConfig.phone}
          <Phone slot="icon" className="h-5 w-5" />
        </Button>
      </div>
    </div>
  </SplitSection>

  {/* Install gallery */}
  <section class="section-padding bg-white">
    <Container>
      <div data-reveal>
        <SectionHeading
          eyebrow="Recent Work"
          heading="Clean Installs. Passed Inspections."
          align="center"
        />
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {
          gallery.map((item, i) => (
            <div
              class="relative"
              data-reveal
              style={`--reveal-delay: ${i * 120}ms`}
            >
              <ImageSlot
                imageKey={item.imageKey}
                aspectRatio="16/10"
                sizes="(min-width: 768px) 50vw, 100vw"
                class="rounded-3xl shadow-card"
              />
              <span class="absolute bottom-3 left-3 max-w-[calc(100%-1.5rem)] rounded-lg bg-foreground/70 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur">
                {item.caption}
              </span>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* What's included */}
  <section class="relative overflow-hidden section-padding bg-primary-900">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(700px_at_80%_10%,rgba(99,207,251,0.12),transparent)]"
      aria-hidden="true"
    >
    </div>
    <Container class="relative">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div data-reveal>
          <h2 class="text-3xl font-bold text-white md:text-4xl">
            One Quote. Everything Included.
          </h2>
          <p class="mt-4 text-white/80">
            No hourly meter, no add-ons discovered halfway through — your
            quote covers the whole job:
          </p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2" data-reveal style="--reveal-delay: 150ms">
          {
            included.map((item) => (
              <li class="flex items-start gap-2.5 rounded-lg bg-white/5 px-3 py-2.5 text-sm text-white/90 ring-1 ring-white/10">
                <Zap className="mt-0.5 h-4 w-4 shrink-0 text-secondary-400" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  {/* Reviews */}
  <section class="section-padding bg-white">
    <Container>
      <div class="flex flex-col items-center text-center" data-reveal>
        <SectionHeading
          eyebrow="Google Reviews"
          heading={`Ask the Neighbors — All ${businessConfig.googleReviewCount} Went Five Stars`}
          align="center"
          class="mb-5"
        />
        <GoogleReviewsPill variant="bordered" />
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          evLandingReviews.map((review, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 120}ms`}>
              <ReviewCard review={review} class="h-full" />
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* FAQ */}
  <FAQSection
    eyebrow="EV Questions"
    heading="Before You Plug In"
    items={faqs}
    bgColor="surface"
  />

  {/* Final CTA — homepage band */}
  <CTASection
    heading="Ready to Retire the Public Charger?"
    text="Free quote in minutes — installed as soon as this week."
    primaryCta={{ label: "Get My Free Quote", href: "#quote" }}
    secondaryCta={{
      label: `Call ${businessConfig.phone}`,
      href: `tel:${businessConfig.phoneRaw}`,
    }}
  />

  {/* Quote form — the page's single #quote anchor */}
  <LandingQuoteSection
    tone="ev"
    eyebrow="Free EV Charger Quote"
    heading="Your Quote, Usually Same Day"
    formHeading="Get Your EV Charger Quote"
    formSubheading="Free, fast, and no obligation — most quotes come back the same day."
    bullets={[
      "Five questions, sixty seconds — that's the whole form",
      "Photos of your panel speed up an exact price",
      "Firm number in writing before any work starts",
    ]}
    urgencyNote="Booking Level 2 installs across all 18 towns we serve this week."
  />

  <RevealInit />
  <StickyCallBar showQuote />
</Layout>
