---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import QuoteSection from "@/components/sections/QuoteSection.astro";
import FAQSection from "@/components/sections/FAQSection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Container from "@/components/ui/Container.astro";
import MapEmbed from "@/components/ui/MapEmbed.astro";
import { contactFaqKeys } from "@/config/faqs";
import { businessConfig } from "@/config/business";
import { imageManifest } from "@/config/images";
import { generatePageMetadata } from "@/lib/metadata";
import { generateBreadcrumbSchema } from "@/lib/structured-data";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

const meta = generatePageMetadata({
  title: "Contact | 24/7 Electrician in Manchester, NH",
  description: `Reach The Speedy Sparky any hour at ${businessConfig.phone} or send the quick quote form — free estimates for homes and businesses across southern NH.`,
  path: "/contact",
});

const heroImg = imageManifest["outlet-wiring-closeup"];
const publicDir = fileURLToPath(new URL("../../public", import.meta.url));
const heroPreload =
  heroImg && existsSync(publicDir + heroImg.src) ? heroImg.src : undefined;

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", href: "/" },
  { name: "Contact", href: "/contact" },
]);
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  ogTitle={meta.ogTitle}
  preloadImage={heroPreload}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <PageHero
    heading="Contact The Speedy Sparky"
    subtitle="Call any hour — emergencies included — or send the form and get your free quote back fast, usually the same day."
    imageKey="outlet-wiring-closeup"
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Contact" },
    ]}
    primaryCta={{ label: "Get a Free Quote", href: "#quote" }}
    secondaryCta={{ label: "Call (603) 661-8432", href: "tel:+16036618432" }}
  />

  <QuoteSection id="quote" />

  {/* Find us on Google */}
  <section class="section-padding bg-white">
    <Container>
      <SectionHeading
        eyebrow="Find Us"
        heading="Proudly Based in Manchester, New Hampshire"
        subtitle="A service-area business covering 18 towns across Hillsborough, Merrimack, and Rockingham counties."
        align="center"
      />
      <div class="overflow-hidden rounded-2xl shadow-card-hover">
        <MapEmbed class="h-[400px] w-full md:h-[460px]" />
      </div>
    </Container>
  </section>

  <FAQSection
    eyebrow="Questions"
    heading="Before You Reach Out"
    subtitle="Answers to common questions about getting started."
    faqKeys={contactFaqKeys}
    bgColor="surface"
  />

  <CTASection
    heading="Prefer to Talk?"
    text={`Give us a call at ${businessConfig.phone}. We're available 24/7 — real emergencies always come first.`}
    primaryCta={{
      label: `Call ${businessConfig.phone}`,
      href: `tel:${businessConfig.phoneRaw}`,
    }}
  />
</Layout>
