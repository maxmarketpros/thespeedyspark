---
import {
  Phone,
  Zap,
  Flame,
  Droplets,
  CloudLightning,
  PowerOff,
  Volume2,
  PhoneCall,
  Headset,
  Truck,
  ArrowRight,
  Star,
  CheckCircle2,
  Siren,
} from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import TrustBar from "@/components/landing/TrustBar.astro";
import StickyCallBar from "@/components/landing/StickyCallBar.astro";
import LandingQuoteSection from "@/components/landing/LandingQuoteSection.astro";
import RevealInit from "@/components/landing/RevealInit.astro";
import FAQSection from "@/components/sections/FAQSection.astro";
import SplitSection from "@/components/sections/SplitSection.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ChecklistItem from "@/components/ui/ChecklistItem.astro";
import ImageSlot from "@/components/ui/ImageSlot.astro";
import ReviewCard from "@/components/ui/ReviewCard.astro";
import GoogleReviewsPill from "@/components/ui/GoogleReviewsPill.astro";
import GoogleLogo from "@/components/ui/GoogleLogo.astro";
import { businessConfig } from "@/config/business";
import { emergencyLandingReviews } from "@/config/reviews";
import { imageManifest } from "@/config/images";
import { generatePageMetadata } from "@/lib/metadata";
import {
  generateLandingServiceSchema,
  generateBreadcrumbSchema,
} from "@/lib/structured-data";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

const meta = generatePageMetadata({
  title: "24/7 Emergency Electrician Manchester NH | The Speedy Sparky",
  description:
    "Electrical emergency? We answer live 24/7 and dispatch fast across Manchester & southern NH. Sparks, outages, burning smells — call (603) 661-8432 now.",
  path: "/emergency-electrician",
});

const serviceSchema = generateLandingServiceSchema({
  name: "Emergency Electrician",
  description: meta.description,
  path: "/emergency-electrician",
});
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", href: "/" },
  { name: "Emergency Electrician", href: "/emergency-electrician" },
]);

const heroChips = [
  "A real electrician answers",
  "~25 min to most towns",
  "Up-front price before work",
  "Nights, weekends & holidays",
];

const callNowIf = [
  {
    icon: Flame,
    title: "Burning Smell or Smoke",
    text: "A fish-like or burning-plastic odor near outlets or the panel means wiring is overheating right now.",
    urgent: true,
  },
  {
    icon: Zap,
    title: "Sparking Outlet or Switch",
    text: "Visible sparks, scorch marks, or a hot cover plate — stop using the circuit and call.",
    urgent: true,
  },
  {
    icon: Volume2,
    title: "Buzzing From the Panel",
    text: "Panels should be silent — buzzing means a failing breaker or loose connection under load.",
    urgent: false,
  },
  {
    icon: PowerOff,
    title: "Partial or Total Power Loss",
    text: "Half the house dark while the neighbors' lights are on points to a failing main.",
    urgent: false,
  },
  {
    icon: Droplets,
    title: "Water Meets Electricity",
    text: "A leak into a fixture, panel, or outlet is a shock and fire risk that can't wait until morning.",
    urgent: false,
  },
  {
    icon: CloudLightning,
    title: "Storm or Surge Damage",
    text: "After a nor'easter or lightning strike — downed service cables, dead circuits, fried equipment.",
    urgent: false,
  },
];

const steps = [
  {
    icon: PhoneCall,
    title: "A Real Person Picks Up",
    text: "No voicemail maze at 2 AM — a licensed electrician answers and knows what to ask.",
  },
  {
    icon: Headset,
    title: "Triage on the Phone",
    text: "We walk you to safety immediately — which breaker to kill, what to unplug, when to step outside.",
  },
  {
    icon: Truck,
    title: "Fast Dispatch, Up-Front Price",
    text: "Most of our 18 towns are within about 25 minutes, and you approve the price before repairs begin.",
  },
];

const whyChecklist = [
  "A live electrician answers — 24/7, holidays included",
  "Safety triage starts the moment you call",
  "Up-front price approved before work begins",
  "Fixed right the first time, at any hour",
];

const gallery = [
  {
    imageKey: "gfci-outlet-install",
    caption: "Found it, fixed it, tested it — one visit",
  },
  {
    imageKey: "wire-connection-work",
    caption: "Repairs done to code, not taped over",
  },
];

const faqs = [
  {
    id: "faq-em-lp-1",
    question: "Do you really answer at night and on holidays?",
    answer:
      "Yes — 24 hours a day, 365 days a year. Emergencies are the reason the phone is always on.",
  },
  {
    id: "faq-em-lp-2",
    question: "How fast can you get here?",
    answer:
      "Manchester and the surrounding towns are usually well within a half hour. Farther corners like Salem, Milford, or Weare take a bit longer — you get an honest ETA when you call.",
  },
  {
    id: "faq-em-lp-3",
    question: "Does emergency service cost extra?",
    answer:
      "After-hours dispatch carries a premium, and we tell you exactly what it is on the phone — before we roll. Repairs are still priced up front, so you approve every dollar before work starts.",
  },
  {
    id: "faq-em-lp-4",
    question: "What should I do while I wait?",
    answer:
      "Whatever we walked through on the phone — usually shutting off the affected breaker and unplugging that circuit. If there's smoke or fire, get out and call 911 first, then us.",
  },
];

const [featuredReview, ...sideReviews] = emergencyLandingReviews;

const heroImg = imageManifest["hero-emergency"];
const publicDir = fileURLToPath(new URL("../../public", import.meta.url));
const heroPreload =
  heroImg && existsSync(publicDir + heroImg.src) ? heroImg.src : undefined;
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  ogTitle={meta.ogTitle}
  preloadImage={heroPreload}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(serviceSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  {/* Hero — homepage-style full-bleed dark image, centered, call-first */}
  <section class="relative flex min-h-screen items-center overflow-hidden">
    <ImageSlot
      imageKey="hero-emergency"
      fill
      priority
      class="lp-bg-settle absolute inset-0 z-0"
      overlayClassName="bg-gradient-to-b from-black/70 via-black/55 to-black/75"
      sizes="100vw"
    />

    <Container class="relative z-10 py-32 text-center">
      <span
        class="lp-fade-up mb-4 inline-flex items-center gap-2.5 rounded-full bg-white/10 px-5 py-2 text-xs font-semibold uppercase tracking-widest text-white ring-1 ring-white/20 backdrop-blur-sm"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full rounded-full bg-red-500 motion-safe:animate-ping"
          >
          </span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
        </span>
        Answering Live — 24/7 · Manchester &amp; Southern NH
      </span>

      <h1
        class="lp-fade-up mx-auto max-w-4xl text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl"
        style="--enter-delay: 80ms"
      >
        Emergency Electrician
        <span
          class="block bg-gradient-to-r from-secondary-300 to-secondary-400 bg-clip-text pb-1 text-transparent"
        >
          in Manchester, NH
        </span>
      </h1>

      <p
        class="lp-fade-up mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl"
        style="--enter-delay: 160ms"
      >
        Sparks, burning smells, half the house dark — call now and a licensed
        electrician answers, walks you to safety, and gets moving any hour of
        any day.
      </p>

      <ul
        class="lp-fade-up mt-7 flex flex-wrap items-center justify-center gap-2.5"
        style="--enter-delay: 240ms"
      >
        {
          heroChips.map((chip) => (
            <li class="flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-2 text-sm font-medium text-white/90 ring-1 ring-white/15 backdrop-blur-sm">
              <CheckCircle2 className="h-4 w-4 shrink-0 text-secondary-400" />
              {chip}
            </li>
          ))
        }
      </ul>

      <div
        class="lp-fade-up mt-7 flex justify-center"
        style="--enter-delay: 320ms"
      >
        <GoogleReviewsPill />
      </div>

      <div
        class="lp-fade-up mt-8 flex flex-col items-center justify-center gap-5"
        style="--enter-delay: 400ms"
      >
        <a
          href={`tel:${businessConfig.phoneRaw}`}
          class="lp-siren-glow inline-flex items-center gap-3 rounded-xl bg-red-700 px-10 py-5 text-xl font-bold text-white transition-colors hover:bg-red-800"
        >
          <Phone className="h-6 w-6" />
          Call {businessConfig.phone} — Live Now
        </a>
        <a
          href="#quote"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-white/70 underline underline-offset-4 transition-colors hover:text-white"
        >
          Not urgent? Get a quote by morning
          <ArrowRight className="h-4 w-4" />
        </a>
      </div>

      {/* Stats row — homepage shell, values count up on load */}
      <div
        class="lp-fade-up mx-auto mt-14 grid w-full max-w-lg grid-cols-3 divide-x divide-white/20 md:mt-16"
        style="--enter-delay: 480ms"
      >
        <div class="min-w-0 px-2 text-center sm:px-4">
          <p
            class="whitespace-nowrap text-2xl font-bold text-white sm:text-3xl md:text-4xl"
          >
            24/7
          </p>
          <p
            class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/70 sm:text-xs sm:tracking-widest"
          >
            Live Answer, Every Day
          </p>
        </div>
        <div class="min-w-0 px-2 text-center sm:px-4">
          <p
            class="whitespace-nowrap text-2xl font-bold text-white sm:text-3xl md:text-4xl"
          >
            <span data-count-to="25" data-count-prefix="~">~25</span> min
          </p>
          <p
            class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/70 sm:text-xs sm:tracking-widest"
          >
            To Most of Southern NH
          </p>
        </div>
        <div class="min-w-0 px-2 text-center sm:px-4">
          <p class="text-2xl font-bold text-white sm:text-3xl md:text-4xl">
            <span data-count-to="18">18</span>
          </p>
          <p
            class="mt-1 text-[11px] font-semibold uppercase tracking-wide text-white/70 sm:text-xs sm:tracking-widest"
          >
            Towns on the Dispatch Map
          </p>
        </div>
      </div>
    </Container>
  </section>

  <TrustBar />

  {/* Call now if */}
  <section class="section-padding bg-white">
    <Container>
      <div data-reveal>
        <SectionHeading
          eyebrow="Call Now If"
          heading="Six Problems That Shouldn't Wait Until Morning"
          subtitle={`If any of these is happening right now, skip the form and call ${businessConfig.phone}.`}
          align="center"
        />
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          callNowIf.map((item, i) => (
            <div
              class="flex gap-4 rounded-2xl border-l-4 border-l-accent-500 bg-white p-6 shadow-card ring-1 ring-border transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover"
              data-reveal
              style={`--reveal-delay: ${(i % 3) * 100}ms`}
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent-50">
                <item.icon className="h-6 w-6 text-accent-600" />
              </span>
              <div>
                <h3 class="flex items-center gap-2 font-bold text-foreground">
                  {item.title}
                  {item.urgent && (
                    <span class="relative flex h-2 w-2" aria-hidden="true">
                      <span class="lp-pulse-ring absolute inline-flex h-full w-full rounded-full bg-accent-500" />
                      <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-500" />
                    </span>
                  )}
                </h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">
                  {item.text}
                </p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="mt-12 flex justify-center" data-reveal>
        <a
          href={`tel:${businessConfig.phoneRaw}`}
          class="lp-siren-glow inline-flex items-center gap-3 rounded-xl bg-red-700 px-8 py-4 text-lg font-bold text-white transition-colors hover:bg-red-800"
        >
          <Phone className="h-6 w-6" />
          Emergency Line: {businessConfig.phone}
        </a>
      </div>
    </Container>
  </section>

  {/* Why neighbors call us — homepage-style split section */}
  <SplitSection
    imageKey="outdoor-control-cabinet"
    imagePosition="right"
    bgColor="surface"
    imageAspect="4/3"
    badge={{ value: "~25", eyebrow: "Minutes out", label: "Most of Southern NH" }}
  >
    <div data-reveal>
      <SectionHeading
        eyebrow="Why Neighbors Call Us"
        heading="No Voicemail. No Runaround. No Surprise Bill."
      />
      <p class="mb-6 text-base leading-relaxed text-muted md:text-lg">
        Emergency calls go straight to a licensed electrician, not a call
        center. You get safety steps the moment you call, an honest ETA, and
        a price you approve before any work starts.
      </p>
      <div class="mb-8 space-y-4">
        {whyChecklist.map((item) => <ChecklistItem text={item} />)}
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href={`tel:${businessConfig.phoneRaw}`}
          class="lp-siren-glow inline-flex items-center gap-2 rounded-xl bg-red-700 px-7 py-3.5 font-bold text-white transition-colors hover:bg-red-800"
        >
          <Phone className="h-5 w-5" />
          Call {businessConfig.phone}
        </a>
        <Button href="#quote" variant="outline">
          Get My Free Quote
          <ArrowRight slot="icon" className="h-5 w-5" />
        </Button>
      </div>
    </div>
  </SplitSection>

  {/* 3-step process */}
  <section class="section-padding bg-white">
    <Container>
      <div data-reveal>
        <SectionHeading
          eyebrow="What Happens Next"
          heading="You Call. We Answer. We Roll."
          align="center"
        />
      </div>
      <div class="relative grid gap-10 md:grid-cols-3 md:gap-8">
        <div
          class="absolute left-[18%] right-[18%] top-10 hidden border-t-2 border-dashed border-primary-200 md:block"
          aria-hidden="true"
        >
        </div>
        {
          steps.map((step, i) => (
            <div
              class="relative rounded-2xl bg-white p-7 ring-1 ring-border shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover"
              data-reveal
              style={`--reveal-delay: ${i * 120}ms`}
            >
              <div class="absolute -top-4 left-7 flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-primary-600 to-secondary-500 text-sm font-bold text-white shadow-badge">
                {i + 1}
              </div>
              <step.icon className="h-8 w-8 text-primary-600" />
              <h3 class="mt-4 text-lg font-bold text-foreground">
                {step.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* Reviews — featured 11 PM rescue */}
  <section class="section-padding bg-surface">
    <Container>
      <div class="flex flex-col items-center text-center" data-reveal>
        <SectionHeading
          eyebrow="Google Reviews"
          heading="Rescued Neighbors, In Their Own Words"
          align="center"
          class="mb-5"
        />
        <GoogleReviewsPill variant="bordered" />
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {/* Featured: the 11 PM blizzard rescue */}
        <figure
          class="relative flex flex-col rounded-3xl bg-white p-8 shadow-card-hover lg:col-span-2"
          data-reveal
        >
          <span
            class="absolute -top-3 left-8 rounded-full bg-accent-600 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-badge"
          >
            11:00 PM Call
          </span>
          <div class="flex items-center gap-1" aria-hidden="true">
            {
              Array.from({ length: 5 }).map(() => (
                <Star className="h-5 w-5 fill-star text-star" />
              ))
            }
          </div>
          <span class="sr-only">Rated {featuredReview.rating} out of 5 stars</span>
          <blockquote class="mt-5 flex-1 text-lg leading-relaxed text-foreground-light">
            "{featuredReview.text}"
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <span
              class="flex h-11 w-11 items-center justify-center rounded-full bg-accent-600 text-sm font-bold text-white"
              aria-hidden="true"
            >
              {featuredReview.initials}
            </span>
            <div class="flex-1">
              <p class="font-bold text-foreground">{featuredReview.name}</p>
              <p class="text-xs text-muted">{featuredReview.relativeDate}</p>
            </div>
            <GoogleLogo class="h-6 w-6" />
          </figcaption>
        </figure>
        <div class="flex flex-col gap-6">
          {
            sideReviews.map((review, i) => (
              <div
                class="flex-1"
                data-reveal
                style={`--reveal-delay: ${(i + 1) * 120}ms`}
              >
                <ReviewCard review={review} class="h-full" />
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  {/* Work gallery */}
  <section class="section-padding bg-white">
    <Container>
      <div data-reveal>
        <SectionHeading
          eyebrow="After the Callout"
          heading="Fixed Right at Any Hour"
          align="center"
        />
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {
          gallery.map((item, i) => (
            <div
              class="relative"
              data-reveal
              style={`--reveal-delay: ${i * 120}ms`}
            >
              <ImageSlot
                imageKey={item.imageKey}
                aspectRatio="16/10"
                sizes="(min-width: 768px) 50vw, 100vw"
                class="rounded-3xl shadow-card"
              />
              <span class="absolute bottom-3 left-3 max-w-[calc(100%-1.5rem)] rounded-lg bg-foreground/70 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur">
                {item.caption}
              </span>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  {/* FAQ */}
  <FAQSection
    eyebrow="Emergency FAQ"
    heading="The Questions People Ask at Midnight"
    items={faqs}
    bgColor="surface"
  />

  {/* Final CTA — save the number, lights in the dark */}
  <section class="relative overflow-hidden section-padding bg-foreground">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(620px_at_12%_18%,rgba(239,68,68,0.16),transparent)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(620px_at_88%_85%,rgba(59,130,246,0.18),transparent)]"
      aria-hidden="true"
    >
    </div>
    <Container class="relative">
      <div class="flex flex-col items-center gap-6 text-center" data-reveal>
        <span
          class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white/10 ring-1 ring-white/15"
        >
          <Siren className="h-7 w-7 text-red-400" />
        </span>
        <h2 class="max-w-2xl text-3xl font-bold text-white md:text-4xl">
          Save This Number Before You Need It
        </h2>
        <p class="max-w-xl text-white/80">
          Electrical problems get worse, not better — and the night you smell
          burning plastic is the wrong night to start googling.
        </p>
        <a
          href={`tel:${businessConfig.phoneRaw}`}
          class="lp-siren-glow inline-flex items-center gap-3 rounded-xl bg-red-700 px-10 py-5 text-xl font-bold text-white transition-colors hover:bg-red-800"
        >
          <Phone className="h-6 w-6" />
          Call {businessConfig.phone} Now
        </a>
        <p class="text-sm text-white/70">
          Live answer 24/7 · Licensed NH Electrician #15673 · 18 southern NH
          towns
        </p>
        <a
          href="#quote"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-white underline underline-offset-4 hover:text-white/80"
        >
          Not urgent? Request a quote instead
          <ArrowRight className="h-4 w-4" />
        </a>
      </div>
    </Container>
  </section>

  {/* Quote form — the page's single #quote anchor */}
  <LandingQuoteSection
    tone="emergency"
    swapColumns
    eyebrow="The Morning Line"
    heading="If It Can't Wait"
    formHeading="Not Urgent? Request a Quote"
    formSubheading="For anything that can wait until daylight — we'll get back to you fast."
    bullets={[
      "A live electrician answers — no call center",
      "Safety triage starts the moment you call",
      "Up-front pricing, approved before work begins",
    ]}
    urgencyNote="Form replies come first thing in the morning — emergencies always jump the line. If something is sparking, smoking, or buzzing right now, call instead."
  />

  <RevealInit />
  <StickyCallBar variant="emergency" />
</Layout>
