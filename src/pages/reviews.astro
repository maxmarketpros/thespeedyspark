---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import ReviewsGrid from "@/components/sections/ReviewsGrid.astro";
import ReviewPlatforms from "@/components/sections/ReviewPlatforms.astro";
import CTASection from "@/components/sections/CTASection.astro";
import QuoteSection from "@/components/sections/QuoteSection.astro";
import GoogleReviewsPill from "@/components/ui/GoogleReviewsPill.astro";
import Container from "@/components/ui/Container.astro";
import { googleReviews } from "@/config/reviews";
import { businessConfig } from "@/config/business";
import { generatePageMetadata } from "@/lib/metadata";
import { generateBreadcrumbSchema } from "@/lib/structured-data";

const meta = generatePageMetadata({
  title: "Reviews | 5.0-Star Electrician in Manchester, NH",
  description:
    "46 Google reviews, every one five stars. Read what Manchester & southern NH homeowners say about The Speedy Sparky — then add your own experience.",
  path: "/reviews",
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: "Home", href: "/" },
  { name: "Reviews", href: "/reviews" },
]);
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  ogTitle={meta.ogTitle}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <PageHero
    heading="Rated 5.0 Stars by the Neighbors We Serve"
    subtitle="Every review below is a real Google review from a real customer — panel fires fixed at midnight, chandeliers hung on 30-foot ceilings, and a lot of tidy work in between."
    imageKey="deck-uplighting-evening"
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Reviews" }]}
    primaryCta={{ label: "Get a Free Quote", href: "/contact" }}
    secondaryCta={{
      label: `Call ${businessConfig.phone}`,
      href: `tel:${businessConfig.phoneRaw}`,
    }}
  />

  <section class="section-padding-sm bg-white">
    <Container>
      <div class="flex justify-center">
        <GoogleReviewsPill variant="bordered" />
      </div>
    </Container>
  </section>

  <ReviewsGrid
    reviews={googleReviews}
    eyebrow="Straight From Google"
    heading="What Customers Tell Their Neighbors"
    subtitle="Unedited reviews from homeowners and businesses across Manchester, Nashua, and the surrounding towns."
  />

  <ReviewPlatforms />

  <CTASection
    heading="Experience the Five-Star Treatment Yourself"
    text="Join 46 happy neighbors — call now or request your free quote and see why nobody's given us less than five stars."
    primaryCta={{ label: "Get a Free Quote", href: "/contact" }}
    secondaryCta={{
      label: `Call ${businessConfig.phone}`,
      href: `tel:${businessConfig.phoneRaw}`,
    }}
  />

  <QuoteSection />
</Layout>
