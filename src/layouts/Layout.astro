---
import "@/styles/globals.css";
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";

import { Header } from "@/components/layout/Header";
import Footer from "@/components/layout/Footer.astro";
import { siteConfig } from "@/config/site";
import {
  generateLocalBusinessSchema,
  generateWebsiteSchema,
} from "@/lib/structured-data";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogTitle?: string;
  noindex?: boolean;
  preloadImage?: string;
  /** "landing" renders the minimal conversion header (logo + phone + CTA) */
  headerVariant?: "default" | "landing";
  solidHeader?: boolean;
}

const {
  title = `${siteConfig.name} | ${siteConfig.tagline}`,
  description = siteConfig.description,
  canonical,
  ogImage = siteConfig.ogImage,
  ogTitle,
  noindex = false,
  preloadImage,
  headerVariant = "default",
  solidHeader = false,
} = Astro.props as Props;

// Netlify serves directory-format builds at trailing-slash URLs (and 301s the
// bare form), so canonicals must carry the slash to match the sitemap and the
// final URL — otherwise every canonical points at a redirect.
const rawCanonical =
  canonical || new URL(Astro.url.pathname, siteConfig.url).toString();
const canonicalUrl = rawCanonical.endsWith("/")
  ? rawCanonical
  : `${rawCanonical}/`;
const ogTitleResolved = ogTitle || title;
const absoluteOgImage = new URL(ogImage, siteConfig.url).toString();

const localBusinessSchema = generateLocalBusinessSchema();
const websiteSchema = generateWebsiteSchema();
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Google tag (gtag.js) — Google Ads AW-18295104633 */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-18295104633"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "AW-18295104633");

      // Event snippet for Click to call conversion page.
      // The timeout fallback ensures the call still goes through even if
      // gtag is blocked and the event_callback never fires.
      function gtag_report_conversion(url) {
        var navigated = false;
        var callback = function () {
          if (!navigated && typeof url != "undefined") {
            navigated = true;
            window.location = url;
          }
        };
        setTimeout(callback, 1500);
        gtag("event", "conversion", {
          send_to: "AW-18295104633/jyLhCJn75skcEPnI5JNE",
          value: 1.0,
          currency: "USD",
          event_callback: callback,
          event_timeout: 2000,
        });
        return false;
      }

      // Report a conversion for EVERY tel: link on the site (header, footer,
      // info bar, CTAs, sticky call bar) without per-element onclick attributes.
      document.addEventListener("click", function (e) {
        var link =
          e.target && e.target.closest
            ? e.target.closest('a[href^="tel:"]')
            : null;
        if (!link) return;
        e.preventDefault();
        gtag_report_conversion(link.href);
      });
    </script>

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <meta name="theme-color" content="#3268cb" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.name} />
    <meta name="application-name" content={siteConfig.name} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />

    {/* DNS prefetch for lazy-loaded map embeds */}
    <link rel="dns-prefetch" href="https://www.google.com" />

    {/* Optional LCP image preload */}
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          fetchpriority="high"
        />
      )
    }

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={ogTitleResolved} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content={ogTitleResolved} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitleResolved} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogTitleResolved} />

    <meta name="generator" content={Astro.generator} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(localBusinessSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteSchema)}
    />

    <slot name="head" />
  </head>
  <body class="flex min-h-full flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[10000] focus:rounded-lg focus:bg-primary-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary-300"
    >
      Skip to main content
    </a>
    <Header client:load variant={headerVariant} forceSolid={solidHeader} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
