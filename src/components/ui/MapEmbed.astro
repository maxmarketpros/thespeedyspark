---
import { getMapEmbedUrl, businessConfig } from "@/config/business";
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
  /** Override the embed URL (service-area pages pass their own city map) */
  src?: string;
  title?: string;
}

const { class: className, src, title } = Astro.props as Props;
const embedUrl = src || getMapEmbedUrl();
const { city, state } = businessConfig.address;
const mapTitle = title || `Map showing ${city}, ${state} service area`;
---

<iframe
  src={embedUrl}
  title={mapTitle}
  class={cn("w-full border-0", className)}
  allowfullscreen
  loading="lazy"
  referrerpolicy="no-referrer-when-downgrade"></iframe>
