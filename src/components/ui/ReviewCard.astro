---
import { Star } from "lucide-react";
import GoogleLogo from "./GoogleLogo.astro";
import { cn } from "@/lib/utils";
import type { ReviewItem } from "@/types";

interface Props {
  review: ReviewItem;
  class?: string;
}

const { review, class: className } = Astro.props as Props;

// Static class list so Tailwind can see every variant
const avatarColors = [
  "bg-primary-600",
  "bg-secondary-600",
  "bg-accent-600",
  "bg-primary-800",
  "bg-accent-700",
  "bg-primary-500",
];
const avatarColor = avatarColors[review.avatarColorIndex % avatarColors.length];
---

<div
  class={cn(
    "flex flex-col rounded-2xl bg-white p-6 shadow-card transition-shadow hover:shadow-card-hover",
    className,
  )}
>
  <div class="flex items-start justify-between">
    <div class="flex items-center gap-3">
      <div
        class={cn(
          "flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white",
          avatarColor,
        )}
        aria-hidden="true"
      >
        {review.initials}
      </div>
      <div>
        <p class="text-sm font-semibold text-foreground">{review.name}</p>
        <p class="text-xs text-muted">{review.relativeDate}</p>
      </div>
    </div>
    <GoogleLogo class="h-5 w-5 shrink-0" />
  </div>

  <div class="mt-3 flex gap-0.5" aria-hidden="true">
    {
      Array.from({ length: 5 }).map((_, i) => (
        <Star
          className={cn(
            "h-4 w-4",
            i < review.rating
              ? "fill-star text-star"
              : "fill-border text-border",
          )}
        />
      ))
    }
  </div>
  <span class="sr-only">Rated {review.rating} out of 5 stars</span>

  <blockquote class="mt-3 flex-1 text-sm leading-relaxed text-foreground-light">
    {review.text}
  </blockquote>
</div>
