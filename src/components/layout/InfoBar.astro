---
import { MapPin, Zap, Phone } from "lucide-react";
import Container from "@/components/ui/Container.astro";
import { businessConfig } from "@/config/business";
---

<div class="bg-primary-600 text-white">
  <Container>
    <div
      class="flex flex-col items-center justify-between gap-3 py-3.5 text-sm md:flex-row md:gap-6"
    >
      <div class="flex items-center gap-2">
        <MapPin className="h-4 w-4 text-secondary-300" />
        <span>Serving Manchester, NH &amp; Southern New Hampshire</span>
      </div>
      <div class="hidden h-4 w-px bg-white/20 md:block"></div>
      <a
        href="/emergency-electrician"
        class="flex items-center gap-2 transition-colors hover:text-secondary-200"
      >
        <Zap className="h-4 w-4 text-secondary-300" />
        <span>24/7 Emergency Electrician</span>
      </a>
      <div class="hidden h-4 w-px bg-white/20 md:block"></div>
      <a
        href={`tel:${businessConfig.phoneRaw}`}
        class="flex items-center gap-2 transition-colors hover:text-secondary-200"
      >
        <Phone className="h-4 w-4 text-secondary-300" />
        <span>Call {businessConfig.phone}</span>
      </a>
    </div>
  </Container>
</div>
